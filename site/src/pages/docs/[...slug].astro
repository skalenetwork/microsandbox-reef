---
import type { InferGetStaticPropsType, MarkdownInstance } from "astro";
import Layout from "../../layouts/Layout.astro";
import { docs } from "../../content";

export const getStaticPaths = () =>
  Object.entries(import.meta.glob<MarkdownInstance<Record<string, unknown>>>("../../../../docs/*/*.md", { eager: true })).map(
    ([file, doc]) => ({ params: { slug: file.split("/docs/")[1]!.replace(".md", "") }, props: { doc } }),
  );

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const path = `/docs/${Astro.params.slug}`;
const { Content } = Astro.props.doc;
const doc = docs.find((doc) => doc.path === path);
if (!doc) throw new Error(`${path}: add it to ORDER in src/content.ts`);
---

<Layout title={`${doc.title} - reef`} path={path} summary={doc.summary}>
  <article>
    <Content />
  </article>
</Layout>
