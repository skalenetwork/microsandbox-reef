---
import { Code } from "astro:components";
import Layout from "../layouts/Layout.astro";
import { bullets, description, install, url } from "../content";

const journey = `# is this host ready?
reef doctor

# fetch the openclaw role and import it
curl -fsSLO ${url("/roles/openclaw.toml")}
reef role apply openclaw.toml

# one agent from it, with its own gateway token
token=$(openssl rand -hex 32)
reef agent create --role openclaw --name claw \\
  --env OPENCLAW_GATEWAY_TOKEN=$token
reef agent get claw --wait`;
const prompt = `Install reef and create my first agent.
Start with ${url("/llms.txt")}`;
const html = (markdown: string) => markdown.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');
---

<Layout title={`reef - ${description}`} path="/">
  <Code code={install} lang="sh" theme="css-variables" class="clear" />
  <ul>
    {bullets.map((bullet) => <li set:html={html(bullet)} />)}
  </ul>
  <div class="group">
    <p>In your terminal</p>
    <Code code={journey} lang="sh" theme="css-variables" />
  </div>
  <div class="group">
    <p>Or tell your agent</p>
    <Code code={prompt} lang="text" theme="css-variables" wrap class="clear" />
  </div>
</Layout>
