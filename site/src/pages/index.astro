---
import { Code } from "astro:components";
import Layout from "../layouts/Layout.astro";
import Egress from "../components/Egress.astro";
import Keys from "../components/Keys.astro";
import Approve from "../components/Approve.astro";
import Terminals from "../components/Terminals.astro";
import Store from "../components/Store.astro";
import Upgrade from "../components/Upgrade.astro";
import DocsNav from "../components/DocsNav.astro";
import { blocks, description, install, intro, url } from "../content";

const prompt = `I want to start using reef.
Read ${url("/llms.txt")} and tell me about it.`;
const visuals = [Egress, Keys, Approve, Terminals, Store, Upgrade];
const html = (markdown: string) => markdown.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');
---

<Layout title={`reef - ${description}`} path="/">
  <section>
    <h2>Ask your agent</h2>
    <Code code={prompt} lang="text" theme="css-variables" wrap class="clear" />
  </section>
  <p class="intro" set:html={html(intro)} />
  <div class="blocks">
    {
      blocks.map((block, i) => {
        const Visual = visuals[i];
        return (
          <section>
            <div class="visual"><Visual /></div>
            <h2>{block.title}</h2>
            <p>{block.text}</p>
          </section>
        );
      })
    }
  </div>
  <section>
    <h2>Install it yourself</h2>
    <Code code={install} lang="sh" theme="css-variables" class="clear" />
  </section>
  <section>
    <h2>Go deeper</h2>
    <DocsNav />
  </section>
</Layout>
