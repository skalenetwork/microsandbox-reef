---
import type { ImageMetadata } from "astro";
import { Font, Image, getImage } from "astro:assets";
import { Copy01Icon, Tick02Icon } from "@hugeicons/core-free-icons";
import DocsNav from "../components/DocsNav.astro";
import { description, latest, repo, url } from "../content";
import logo from "../assets/reef.png";
import fallback from "../assets/og.jpg";
import "../styles.css";

type Props = { title: string; path: string; summary?: string };

const { title, path, summary = description } = Astro.props;
const icon = await getImage({ src: logo, width: 64, format: "png" });
const cards = import.meta.glob<{ default: ImageMetadata }>("../assets/og/**/*.jpg", { eager: true });
const og = cards[`../assets/og${path}.jpg`]?.default ?? fallback;
const links = [
  { href: "/", label: "Home" },
  { href: "/docs", label: "Docs" },
  { href: "/blog", label: "Blog" },
  { href: repo, label: "GitHub" },
];
const current = (href: string) => (href === path ? "page" : href !== "/" && path.startsWith(href) ? "true" : undefined);
const kebab = (k: string) => k.replace(/[A-Z]/g, (c) => `-${c.toLowerCase()}`);
const svg = (icon: typeof Copy01Icon) =>
  icon
    .map(([tag, attrs]) => {
      const rendered = Object.entries(attrs)
        .filter(([k]) => k !== "key")
        .map(([k, v]) => `${kebab(k)}="${v}"`)
        .join(" ");
      return `<${tag} ${rendered}/>`;
    })
    .join("");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={summary} />
    <link rel="icon" href={icon.src} />
    <link rel="canonical" href={url(path)} />
    <link rel="alternate" type="application/rss+xml" title="reef" href={url("/rss.xml")} />
    <meta property="og:type" content={path.startsWith("/blog/") ? "article" : "website"} />
    <meta property="og:url" content={url(path)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={summary} />
    <meta property="og:image" content={url(og.src)} />
    <meta property="og:image:width" content={og.width} />
    <meta property="og:image:height" content={og.height} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={path.startsWith("/blog/") ? title : description} />
    <Font cssVariable="--font" preload />
  </head>
  <body>
    <main>
      <a class="hero" href="/">
        <Image src={logo} width={40} densities={[1, 2, 3]} format="png" loading="eager" alt="" />
        <div>
          <h1>reef</h1>
          <p>{description}</p>
        </div>
      </a>
      <nav aria-label="Site">
        {links.map((link) => <a href={link.href} aria-current={current(link.href)}>{link.label}</a>)}
        <a class="release" data-latest={latest} href={`${repo}/releases/latest`} hidden></a>
      </nav>
      <slot />
    </main>
    <footer>© {new Date().getFullYear()} SKALE Labs. MIT License. Built on <a href="https://microsandbox.dev">microsandbox</a>.</footer>
    {path.startsWith("/docs/") && (
      <aside>
        <DocsNav current={path} />
      </aside>
    )}
    <template id="copy">
      <button aria-label="Copy">
        {[Copy01Icon, Tick02Icon].map((icon) => <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true" set:html={svg(icon)} />)}
      </button>
    </template>
    <script>
      const template = document.querySelector<HTMLTemplateElement>("#copy")!;

      for (const pre of document.querySelectorAll("pre")) {
        const copy = document.createElement("div");
        copy.className = "copy";
        pre.before(copy);
        copy.append(pre, template.content.cloneNode(true));

        const button = copy.querySelector("button")!;
        button.addEventListener("click", async () => {
          await navigator.clipboard.writeText(pre.textContent!);
          button.dataset.copied = "";
          button.ariaLabel = "Copied";
          setTimeout(() => {
            delete button.dataset.copied;
            button.ariaLabel = "Copy";
          }, 1500);
        });
      }

      const release = document.querySelector<HTMLAnchorElement>(".release")!;
      const version = await fetch(release.dataset.latest!)
        .then((res) => res.json())
        .then((data) => String(data.value))
        .catch(() => "");

      if (/^v\d/.test(version)) {
        release.textContent = version;
        release.hidden = false;
      }
    </script>
  </body>
</html>
