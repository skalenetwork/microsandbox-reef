---
import { Font, Image, getImage } from "astro:assets";
import DocsNav from "../components/DocsNav.astro";
import { description, url } from "../content";
import logo from "../assets/reef.png";
import og from "../assets/og.jpg";
import "../styles.css";

type Props = { title: string; path: string };

const { title, path } = Astro.props;
const icon = await getImage({ src: logo, width: 64, format: "png" });
const links = [
  { href: "/", label: "Home" },
  { href: "/docs", label: "Docs" },
  { href: "https://github.com/skalenetwork/reef", label: "GitHub" },
];
const active = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={icon.src} />
    <link rel="canonical" href={url(path)} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url(path)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={url(og.src)} />
    <meta property="og:image:width" content={og.width} />
    <meta property="og:image:height" content={og.height} />
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--font" preload />
  </head>
  <body>
    <main>
      <a class="hero" href="/">
        <Image src={logo} width={40} densities={[1, 2, 3]} loading="eager" alt="" />
        <div>
          <h1>reef</h1>
          <p>{description}</p>
        </div>
      </a>
      <nav>
        {links.map((link) => <a href={link.href} aria-current={active(link.href) ? "page" : undefined}>{link.label}</a>)}
      </nav>
      <slot />
    </main>
    <footer>© {new Date().getFullYear()} SKALE Labs. MIT License.</footer>
    {path.startsWith("/docs") && (
      <aside>
        <DocsNav current={path} />
      </aside>
    )}
  </body>
</html>
