---
type Props = { id?: string; section?: string; title?: string; lead?: string; class?: string };

const { id, section, title, lead, class: klass } = Astro.props;
---

<section id={id} class:list={["slide", klass]}>
  <div class="frame">
    {
      (section || title || lead) && (
        <header>
          {section && <p class="label">{section}</p>}
          {title && <h2>{title}</h2>}
          {lead && <p class="lead">{lead}</p>}
        </header>
      )
    }
    <div class="body">
      <slot />
    </div>
    {klass?.includes("appendix") && <a class="back" href="#appendix">Appendix</a>}
    <p class="n" aria-hidden="true"></p>
  </div>
</section>
