/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self' https://img.shields.io; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

/install
  Content-Type: text/plain; charset=utf-8

/rss.xml
  Content-Type: application/rss+xml; charset=utf-8

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/reef-ui.gif
  Cache-Control: public, max-age=604800

/reef-ui.png
  Cache-Control: public, max-age=604800
